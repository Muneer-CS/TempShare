# Loopback-only listener: the dashboard UI + management API (create/list/
# revoke/delete shares). NEVER point a tunnel, reverse proxy, or port
# forward at this address.
TEMPSHARE_BIND_ADDR=127.0.0.1:7420

# Public download listener. Keep this on loopback when using the automatic
# tunnel so Windows does not expose the port directly to the network.
TEMPSHARE_PUBLIC_BIND_ADDR=127.0.0.1:7421

# Base URL placed in generated share links. Set this to your HTTPS tunnel or
# reverse-proxy URL when exposing TempShare publicly.
TEMPSHARE_PUBLIC_BASE_URL=http://127.0.0.1:7421

# Automatically create a temporary HTTPS trycloudflare.com address. The
# bundled Windows package includes cloudflared and enables this by default.
# Set false to use TEMPSHARE_PUBLIC_BASE_URL instead.
TEMPSHARE_AUTO_TUNNEL=true

# Where shared files are physically stored on this machine.
TEMPSHARE_STORAGE_DIR=./data/shared_files

# SQLite database location.
TEMPSHARE_DB_PATH=./data/tempshare.db

# Hard cap on a single share's size, in bytes. Default: 50 GB.
TEMPSHARE_MAX_UPLOAD_BYTES=53687091200

# Global per-IP request budget on the public listener (requests / minute).
TEMPSHARE_RATE_LIMIT_PER_MIN=120

# Password-unlock token lifetime in seconds. Default: 15 minutes.
TEMPSHARE_UNLOCK_TOKEN_TTL_SECS=900

# Optional per-download-connection byte-rate cap. Zero means unlimited.
TEMPSHARE_BANDWIDTH_BYTES_PER_SEC=0

# Optional: set RUST_LOG for more/less verbose logging, e.g.:
# RUST_LOG=tempshare=debug,tower_http=debug
